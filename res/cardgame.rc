// Windows executable icon. Explorer, the taskbar's pinned entry and the
// Alt-Tab list all read this compiled-in resource rather than anything the
// program does at runtime; SDL_SetWindowIcon in Platform.cpp covers the live
// window, and is the only icon at all on Linux.
//
// 1 is the conventional id: Windows shows the numerically lowest ICON
// resource as the application icon.
1 ICON "../assets/icon.ico"

// Version metadata.
//
// The binary shipped with all of this empty, which is a real problem for
// heuristic scanners: unsigned + zero download reputation + no identifying
// metadata is the profile they treat as suspicious. Legitimate software
// almost always carries a VERSIONINFO block, and hastily built malware
// usually does not, so its absence counts against us.
//
// This does not replace code signing - it is the cheap half of looking like
// real software rather than an anonymous 3 MB executable.
#define VER_MAJOR 0
#define VER_MINOR 9
#define VER_PATCH 3

1 VERSIONINFO
FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS         0x40004L        // VOS_NT_WINDOWS32
FILETYPE       0x1L            // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"       // US English, Unicode
        {
            VALUE "CompanyName",      "Shayanmh2"
            VALUE "FileDescription",  "Roguelike Cardgame"
            VALUE "FileVersion",      "0.9.3.0"
            VALUE "InternalName",     "cardgame_sdl2"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Shayanmh2"
            VALUE "OriginalFilename", "cardgame_sdl2.exe"
            VALUE "ProductName",      "Roguelike Cardgame"
            VALUE "ProductVersion",   "0.9.3.0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
